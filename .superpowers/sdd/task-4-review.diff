+	character: number;
+	references: Location[];
+	totalReferences: number;
+	truncated: boolean;
+	error?: string;
+	errorKind?: "missing_dependency";
+}
+
+export interface LspSymbolsDetails {
+	filePath: string;
+	scope: "document" | "workspace";
+	query?: string;
+	symbols: Array<DocumentSymbol | SymbolInfo>;
+	totalSymbols: number;
