{
  "name": "oh-my-agent",
  "version": "0.1.0",
  "description": "Your personal agent harness. 15 agents, audit-loop verification, ML/AI skills, one-command install.",
  "main": "./dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",

  "bin": {
    "oh-my-agent": "bin/oh-my-opencode.js",
    "oma": "bin/oh-my-opencode.js"
  },
  "files": [
    "dist",
    "bin",
    "postinstall.mjs",
    ".opencode/command",
    ".opencode/skills",
    ".agents/command",
    ".agents/skills",
    "packages/lsp-tools-mcp/package.json",
    "packages/lsp-core/package.json",
    "packages/lsp-core/src",
    "packages/lsp-tools-mcp/dist",
    "packages/lsp-daemon/package.json",
    "packages/lsp-daemon/dist",
    "packages/git-bash-mcp/dist",
    "packages/shared-skills/package.json",
    "packages/shared-skills/index.mjs",
    "packages/shared-skills/skills"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": "./dist/index.js",
    "./schema.json": "./dist/oh-my-agent.schema.json"
  },
  "scripts": {
    "build": "bun run build:git-bash-mcp && bun run build:lsp-tools-mcp && bun run build:lsp-daemon && bun build src/index.ts --outdir dist --target bun --format esm --external zod && bun run build:shared-skills-assets && tsc --emitDeclarationOnly && bun build src/cli/index.ts --outdir dist/cli --target bun --format esm && bun run build:schema",
    "build:shared-skills-assets": "node -e \"fs.rmSync('dist/skills',{recursive:true,force:true})\" && node -e \"fs.cpSync('packages/shared-skills/skills','dist/skills',{recursive:true,force:true})\"",
    "build:lsp-tools-mcp": "npm --prefix packages/lsp-tools-mcp ci && npm --prefix packages/lsp-tools-mcp run build",
    "build:lsp-daemon": "npm --prefix packages/lsp-daemon ci && npm --prefix packages/lsp-daemon run build",
    "build:all": "bun run build",
    "build:schema": "bun run script/build-schema.ts",
    "build:model-capabilities": "bun run script/build-model-capabilities.ts",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsgo --noEmit && bun run typecheck:script",
    "typecheck:script": "tsgo --noEmit -p script/tsconfig.json",
    "test": "bun test",
    "build:git-bash-mcp": "bun run --cwd packages/git-bash-mcp build"
  },
  "keywords": [
    "opencode",
    "plugin",
    "oracle",
    "librarian",
    "agents",
    "ai",
    "llm"
  ],
  "author": "keypaa",
  "license": "SUL-1.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keypaa/oh-my-agent.git"
  },
  "bugs": {
    "url": "https://github.com/keypaa/oh-my-agent/issues"
  },
  "homepage": "https://github.com/keypaa/oh-my-agent#readme",
  "dependencies": {
    "@clack/prompts": "^1.4.0",
    "@code-yeongyu/comment-checker": "^0.8.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@opencode-ai/plugin": "1.15.13",
    "@opencode-ai/sdk": "1.15.13",
    "commander": "^14.0.3",
    "detect-libc": "^2.1.2",
    "diff": "^9.0.0",
    "js-yaml": "^4.1.1",
    "jsonc-parser": "^3.3.1",
    "picocolors": "^1.1.1",
    "picomatch": "^4.0.4",
    "vscode-jsonrpc": "^8.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@typescript/native-preview": "7.0.0-dev.20260518.1",
    "@types/js-yaml": "^4.0.9",
    "@types/picomatch": "^4.0.3",
    "bun-types": "1.3.14",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "hono": "^4.12.18",
    "@hono/node-server": "^1.19.13",
    "express-rate-limit": "^8.5.1",
    "fast-uri": "^3.1.2",
    "path-to-regexp": "^8.4.2"
  },
  "trustedDependencies": [
    "@code-yeongyu/comment-checker"
  ]
}
